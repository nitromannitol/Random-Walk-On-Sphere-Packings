/-!
# Assumption D

Assumption D of rw-spheres.tex (lines 1438–1462), as printed, for a sequence of nearest-neighbour
walks `W n` on graphs with vertices in `ℝ^d` and a choice `near n z` of a vertex near each point
`z` (the paper's `z^n`, the nearest vertex): there are a domain `D` and `δ > 0` such that for every
`r > 0` and `x ∈ B_δ(D)`, with `B := B_r(x) ∩ B_δ(D)` (closed neighbourhoods, as in the paper's
`B_r(U) = {y : inf_{u ∈ U} ‖y - u‖ ≤ r}`),

* (4.1) `sup_{z ∈ B} ‖z^n - z‖ → 0`, and
* (4.2) for every `h_C` harmonic in a neighbourhood of `B`, the discrete harmonic extension `h_D^n`
  of `h_C` to `V_n[B]` (a solution of `Δ^{G_n} h = 0` in `V_n[B]`, `h = h_C` on `∂V_n[B]`) converges:
  `sup_{z ∈ V_n[B]} |h_D^n(z) - h_C(z)| → 0`, for every choice of solutions.  Existence and
  uniqueness, which the paper presupposes, are not assumed; for bounded data the exit expectation is
  a solution, and convergence of all solutions forces the walk to exit almost surely.

`V_n[B]` is the set of vertices in the interior of `B`, and `∂V_n[B]` the set of the other vertices
adjacent to one of them.
-/

open MeasureTheory Metric Filter Set
open BouRabeeGwynne

namespace SpherePackings

variable {d : ℕ}

/-- **Assumption D** of rw-spheres.tex, as printed. -/
def AssumptionD (W : ℕ → NearestNeighbourWalk d) (near : ∀ n, Euc d → (W n).V)
    (D : Set (Euc d)) (δ : ℝ) : Prop :=
  IsDomain D ∧ 0 < δ ∧ ∀ r : ℝ, 0 < r → ∀ x ∈ cthickening δ D,
    -- (4.1)
    (∀ η : ℝ, 0 < η → ∀ᶠ n in atTop, ∀ z ∈ closedBall x r ∩ cthickening δ D,
      dist ((near n z : Euc d)) z ≤ η) ∧
    -- (4.2)
    ∀ h : Euc d → ℝ, (∃ O : Set (Euc d), IsOpen O ∧ closedBall x r ∩ cthickening δ D ⊆ O ∧
        IsHarmonicOn h O) →
      ∀ η : ℝ, 0 < η → ∀ᶠ n in atTop, ∀ hD : (W n).V → ℝ,
        MarkovChain.SolvesDirichlet (W n).kernel
          ((W n).inner (closedBall x r ∩ cthickening δ D))
          ((W n).boundary (closedBall x r ∩ cthickening δ D)) (fun v => h v) hD →
        ∀ z ∈ (W n).inner (closedBall x r ∩ cthickening δ D), |hD z - h z| ≤ η

end SpherePackings
