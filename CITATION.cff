    title: "Random walk on sphere packings and Delaunay triangulations in arbitrary dimension"
    authors:
      - family-names: "Bou-Rabee"
        given-names: "Ahmed"
      - family-names: "Gwynne"
        given-names: "Ewain"
    identifiers:
      - type: other
        value: "arXiv:2405.11673v2"
    url: "https://arxiv.org/abs/2405.11673"
    notes: "The paper formalized by this repository. Its source, a corrected version and their PDFs are in paper/."
  - type: software
    title: "lean-formalizations: results/bou-rabee-gwynne"
    authors:
      - family-names: "Bonanno"
        given-names: "Leonardo"
        alias: "leobon12"
